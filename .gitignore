# Third-party test suites, fetched by `make suites`. Never vendored.
/third_party/

# Python bytecode from the oracle tools.
__pycache__/
*.pyc

# Oracle virtualenv and generated conformance data.
/.venv/
/testdata/generated/

# Build output
/bin/
# `go build ./tools/gocase` drops its binary in the repository root.
/gocase
*.test
*.out
coverage.txt
tools/.mutate-restore/
