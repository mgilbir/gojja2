{
  "__settings__": {
    "extensions": [
      "loopcontrols"
    ]
  },
  "seq": [
    1,
    2,
    3,
    4,
    5
  ]
}
---
{% for x in seq %}{{ loop.index }}{% if loop.first %}{% continue %}{% endif %}{% endfor %}|{% for x in seq %}{% if loop.last %}{% break %}{% endif %}{{ loop.revindex }}{% endfor %}