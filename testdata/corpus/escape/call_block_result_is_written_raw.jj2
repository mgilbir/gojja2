{
  "__settings__": {
    "autoescape": true
  },
  "__templates__": {
    "esc.txt": "{% autoescape true %}[{% block a %}<A>{% endblock %}]{% endautoescape %}{% autoescape false %}|{% block b %}<B>{% endblock %}|{% endautoescape %}",
    "mac.txt": "{% macro m(x) %}<i>{{ x }}</i>{% endmacro %}",
    "macesc.txt": "{% autoescape false %}{% macro m(x) %}<i>{{ x }}</i>{% endmacro %}{% endautoescape %}"
  }
}
---
{% extends 'esc.txt' %}{% block b %}{% macro takes() %}{{ caller(1) }}>{% endmacro %}{% call(p) takes() %}{% endcall %}{% endblock %}